$(shell mkdir -p rootfsimg/build)

APPS = hello_xsai after_workload gemm_precomp busybox before_workload llama.cpp pmu_test ame_panel_probe ame_hw_probe
# trap qemu_trap dtc lkvm-static

APPS_DIR = $(addprefix apps/, $(APPS))

XSAI_INIT_MODE ?= manual
ifeq ($(XSAI_INIT_MODE),ci)
XSAI_WORKLOAD ?= llama-fake-bench-suite
XSAI_AUTO_EXIT ?= 1
XSAI_DROP_SHELL ?= 0
else
ifeq ($(XSAI_INIT_MODE),shell)
XSAI_WORKLOAD ?= none
XSAI_AUTO_EXIT ?= 0
XSAI_DROP_SHELL ?= 1
else
XSAI_WORKLOAD ?= llama-fake-bench-suite
XSAI_AUTO_EXIT ?= 0
XSAI_DROP_SHELL ?= 1
endif
endif
XSAI_RUN_AFTER_WORKLOAD ?= 1
XSAI_DUMP_THP ?= 1
XSAI_TRACE_WORKLOAD ?= 1
XSAI_LLAMA_TEST_BACKEND_OPS ?= 1
XSAI_LLAMA_FAKE_BENCH_MODELS ?=
XSAI_LLAMA_FAKE_BENCH_P ?= 128
XSAI_TEST_BACKEND_OPS_NEMU_SIGNAL ?= 1
XSAI_TEST_BACKEND_OPS_PROGRESS_LOG ?= 0
XSAI_GGML_AME_LOG ?= 0
XSAI_GGML_AME_PANEL_LOG ?= 0
XSAI_GGML_AME_PANEL_PROGRESS_LOG ?= 0
XSAI_GGML_AME_TILE_PROGRESS_LOG ?= 0
XSAI_GGML_AME_CKPT_ON_SHAPE ?= 0
XSAI_GGML_AME_CKPT_M ?= 2048
XSAI_GGML_AME_CKPT_N ?= 128
XSAI_GGML_AME_CKPT_K ?= 8192
XSAI_GGML_AME_PACKED_Q8 ?= 1
XSAI_GGML_XSAI_OP_PROGRESS_LOG ?= 0
XSAI_AME_SKIP_TILE_B_ZERO ?=1
XSAI_AME_SKIP_TILE_C_ZERO ?=1
XSAI_AME_USE_PACKED_B_PANEL ?= 0
XSAI_AME_PACKED_B_PANEL_MAX_M ?= 288
XSAI_AME_DISABLE_PACKED_A_TILES ?= 0
XSAI_AME_CKPT_BEFORE_TEST_OP ?= 0
XSAI_AME_REPEAT ?= 1
XSAI_AME_M ?= 2048
XSAI_AME_N ?= 128
XSAI_AME_K ?= 8192
XSAI_AME_PANEL_PROBE_KB ?= 128
XSAI_AME_PANEL_PROBE_PASSES ?= 1
XSAI_AME_PANEL_PROBE_M_TILES ?= 16
XSAI_AME_PANEL_PROBE_START_MTILE ?= 0
XSAI_AME_PANEL_PROBE_REUSE_MTILE ?=
XSAI_AME_PANEL_PROBE_START_KB ?= 0
XSAI_AME_PANEL_PROBE_LIMIT_KB ?=
XSAI_AME_PANEL_PROBE_STEP_KB ?= 1
XSAI_AME_PANEL_PROBE_PACKED_LOOP ?= $(XSAI_AME_USE_PACKED_B_PANEL)
XSAI_AME_PANEL_PROBE_PACK_A ?= 1
XSAI_AME_PANEL_PROBE_SCALE ?=
XSAI_AME_PANEL_PROBE_STORE ?=
XSAI_AME_PANEL_PROBE_LOG_EACH ?=
XSAI_AME_PANEL_PROBE_PROGRESS_INTERVAL ?= 128
XSAI_AME_PANEL_PROBE_ITER_PROGRESS ?=
XSAI_AME_PANEL_PROBE_C_BUFFERS ?=
XSAI_AME_PANEL_PROBE_ZERO_C ?= $(if $(filter 1 true TRUE yes YES,$(XSAI_AME_SKIP_TILE_C_ZERO)),0,1)
XSAI_AME_PANEL_PROBE_FENCE_BEFORE ?=
XSAI_AME_PANEL_PROBE_FENCE_AFTER ?=
XSAI_AME_PANEL_PROBE_LEGACY_HOT_LOOP ?=
XSAI_AME_PANEL_PROBE_DETAIL_START ?=
XSAI_AME_PANEL_PROBE_DETAIL_END ?=
XSAI_AME_PANEL_PROBE_STOP_AFTER_TOTAL ?=

.PHONY: rootfsimg xsai-init-config $(APPS_DIR) clean

rootfsimg: xsai-init-config $(APPS_DIR)

xsai-init-config:
	@mkdir -p rootfsimg/build
	@{ \
	  echo "# Generated by firmware/riscv-rootfs/Makefile"; \
	  printf "XSAI_MODE='%s'\n" "$(XSAI_INIT_MODE)"; \
	  printf "WORKLOAD='%s'\n" "$(XSAI_WORKLOAD)"; \
	  printf "AUTO_EXIT='%s'\n" "$(XSAI_AUTO_EXIT)"; \
	  printf "DROP_SHELL='%s'\n" "$(XSAI_DROP_SHELL)"; \
	  printf "RUN_AFTER_WORKLOAD='%s'\n" "$(XSAI_RUN_AFTER_WORKLOAD)"; \
	  printf "DUMP_THP='%s'\n" "$(XSAI_DUMP_THP)"; \
	  printf "TRACE_WORKLOAD='%s'\n" "$(XSAI_TRACE_WORKLOAD)"; \
	  printf "XSAI_LLAMA_TEST_BACKEND_OPS='%s'\n" "$(XSAI_LLAMA_TEST_BACKEND_OPS)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_MODELS='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_MODELS)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_P='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_P)"; \
	  printf "XSAI_TEST_BACKEND_OPS_NEMU_SIGNAL='%s'\n" "$(XSAI_TEST_BACKEND_OPS_NEMU_SIGNAL)"; \
	  printf "XSAI_TEST_BACKEND_OPS_PROGRESS_LOG='%s'\n" "$(XSAI_TEST_BACKEND_OPS_PROGRESS_LOG)"; \
	  printf "GGML_AME_LOG='%s'\n" "$(XSAI_GGML_AME_LOG)"; \
	  printf "GGML_AME_PANEL_LOG='%s'\n" "$(XSAI_GGML_AME_PANEL_LOG)"; \
	  printf "GGML_AME_PANEL_PROGRESS_LOG='%s'\n" "$(XSAI_GGML_AME_PANEL_PROGRESS_LOG)"; \
	  printf "GGML_AME_TILE_PROGRESS_LOG='%s'\n" "$(XSAI_GGML_AME_TILE_PROGRESS_LOG)"; \
	  printf "GGML_AME_CKPT_ON_SHAPE='%s'\n" "$(XSAI_GGML_AME_CKPT_ON_SHAPE)"; \
	  printf "GGML_AME_CKPT_M='%s'\n" "$(XSAI_GGML_AME_CKPT_M)"; \
	  printf "GGML_AME_CKPT_N='%s'\n" "$(XSAI_GGML_AME_CKPT_N)"; \
	  printf "GGML_AME_CKPT_K='%s'\n" "$(XSAI_GGML_AME_CKPT_K)"; \
	  printf "GGML_AME_PACKED_Q8='%s'\n" "$(XSAI_GGML_AME_PACKED_Q8)"; \
	  printf "GGML_XSAI_OP_PROGRESS_LOG='%s'\n" "$(XSAI_GGML_XSAI_OP_PROGRESS_LOG)"; \
	  printf "XSAI_AME_SKIP_TILE_B_ZERO='%s'\n" "$(XSAI_AME_SKIP_TILE_B_ZERO)"; \
	  printf "XSAI_AME_SKIP_TILE_C_ZERO='%s'\n" "$(XSAI_AME_SKIP_TILE_C_ZERO)"; \
	  printf "XSAI_AME_USE_PACKED_B_PANEL='%s'\n" "$(XSAI_AME_USE_PACKED_B_PANEL)"; \
	  printf "XSAI_AME_PACKED_B_PANEL_MAX_M='%s'\n" "$(XSAI_AME_PACKED_B_PANEL_MAX_M)"; \
	  printf "XSAI_AME_DISABLE_PACKED_A_TILES='%s'\n" "$(XSAI_AME_DISABLE_PACKED_A_TILES)"; \
	  printf "XSAI_AME_CKPT_BEFORE_TEST_OP='%s'\n" "$(XSAI_AME_CKPT_BEFORE_TEST_OP)"; \
	  printf "XSAI_AME_REPEAT='%s'\n" "$(XSAI_AME_REPEAT)"; \
	  printf "XSAI_AME_M='%s'\n" "$(XSAI_AME_M)"; \
	  printf "XSAI_AME_N='%s'\n" "$(XSAI_AME_N)"; \
	  printf "XSAI_AME_K='%s'\n" "$(XSAI_AME_K)"; \
	  printf "XSAI_AME_PANEL_PROBE_KB='%s'\n" "$(XSAI_AME_PANEL_PROBE_KB)"; \
	  printf "XSAI_AME_PANEL_PROBE_PASSES='%s'\n" "$(XSAI_AME_PANEL_PROBE_PASSES)"; \
	  printf "XSAI_AME_PANEL_PROBE_M_TILES='%s'\n" "$(XSAI_AME_PANEL_PROBE_M_TILES)"; \
	  printf "XSAI_AME_PANEL_PROBE_START_MTILE='%s'\n" "$(XSAI_AME_PANEL_PROBE_START_MTILE)"; \
	  printf "XSAI_AME_PANEL_PROBE_REUSE_MTILE='%s'\n" "$(XSAI_AME_PANEL_PROBE_REUSE_MTILE)"; \
	  printf "XSAI_AME_PANEL_PROBE_START_KB='%s'\n" "$(XSAI_AME_PANEL_PROBE_START_KB)"; \
	  printf "XSAI_AME_PANEL_PROBE_LIMIT_KB='%s'\n" "$(XSAI_AME_PANEL_PROBE_LIMIT_KB)"; \
	  printf "XSAI_AME_PANEL_PROBE_STEP_KB='%s'\n" "$(XSAI_AME_PANEL_PROBE_STEP_KB)"; \
	  printf "XSAI_AME_PANEL_PROBE_PACKED_LOOP='%s'\n" "$(XSAI_AME_PANEL_PROBE_PACKED_LOOP)"; \
	  printf "XSAI_AME_PANEL_PROBE_PACK_A='%s'\n" "$(XSAI_AME_PANEL_PROBE_PACK_A)"; \
	  printf "XSAI_AME_PANEL_PROBE_SCALE='%s'\n" "$(XSAI_AME_PANEL_PROBE_SCALE)"; \
	  printf "XSAI_AME_PANEL_PROBE_STORE='%s'\n" "$(XSAI_AME_PANEL_PROBE_STORE)"; \
	  printf "XSAI_AME_PANEL_PROBE_LOG_EACH='%s'\n" "$(XSAI_AME_PANEL_PROBE_LOG_EACH)"; \
	  printf "XSAI_AME_PANEL_PROBE_PROGRESS_INTERVAL='%s'\n" "$(XSAI_AME_PANEL_PROBE_PROGRESS_INTERVAL)"; \
	  printf "XSAI_AME_PANEL_PROBE_ITER_PROGRESS='%s'\n" "$(XSAI_AME_PANEL_PROBE_ITER_PROGRESS)"; \
	  printf "XSAI_AME_PANEL_PROBE_C_BUFFERS='%s'\n" "$(XSAI_AME_PANEL_PROBE_C_BUFFERS)"; \
	  printf "XSAI_AME_PANEL_PROBE_ZERO_C='%s'\n" "$(XSAI_AME_PANEL_PROBE_ZERO_C)"; \
	  printf "XSAI_AME_PANEL_PROBE_FENCE_BEFORE='%s'\n" "$(XSAI_AME_PANEL_PROBE_FENCE_BEFORE)"; \
	  printf "XSAI_AME_PANEL_PROBE_FENCE_AFTER='%s'\n" "$(XSAI_AME_PANEL_PROBE_FENCE_AFTER)"; \
	  printf "XSAI_AME_PANEL_PROBE_LEGACY_HOT_LOOP='%s'\n" "$(XSAI_AME_PANEL_PROBE_LEGACY_HOT_LOOP)"; \
	  printf "XSAI_AME_PANEL_PROBE_DETAIL_START='%s'\n" "$(XSAI_AME_PANEL_PROBE_DETAIL_START)"; \
	  printf "XSAI_AME_PANEL_PROBE_DETAIL_END='%s'\n" "$(XSAI_AME_PANEL_PROBE_DETAIL_END)"; \
	  printf "XSAI_AME_PANEL_PROBE_STOP_AFTER_TOTAL='%s'\n" "$(XSAI_AME_PANEL_PROBE_STOP_AFTER_TOTAL)"; \
	} > rootfsimg/build/xsai-init.conf

$(APPS_DIR): %:
	@echo "$$(date '+[rootfs %F %T %z] START $@')"
	@$(MAKE) -s -C $@ install
	@echo "$$(date '+[rootfs %F %T %z] END $@')"

clean:
	-$(foreach app, $(APPS_DIR), $(MAKE) -s -C $(app) clean ;)
	-rm -f rootfsimg/build/*

distclean:
	-$(foreach app, $(APPS_DIR), $(MAKE) -s -C $(app) distclean ;)
	-rm -f rootfsimg/build/*
	-rm -rf apps/busybox/repo
	-rm -rf apps/llama.cpp/repo
