$(shell mkdir -p rootfsimg/build)

APPS = hello_xsai after_workload gemm_precomp busybox before_workload llama.cpp pmu_test
# trap qemu_trap dtc lkvm-static

APPS_DIR = $(addprefix apps/, $(APPS))

XSAI_INIT_MODE ?= manual
ifeq ($(XSAI_INIT_MODE),ci)
XSAI_WORKLOAD ?= llama-fake-bench-suite
XSAI_AUTO_EXIT ?= 1
XSAI_DROP_SHELL ?= 0
else
ifeq ($(XSAI_INIT_MODE),shell)
XSAI_WORKLOAD ?= none
XSAI_AUTO_EXIT ?= 0
XSAI_DROP_SHELL ?= 1
else
XSAI_WORKLOAD ?= llama-fake-bench-suite
XSAI_AUTO_EXIT ?= 0
XSAI_DROP_SHELL ?= 1
endif
endif
XSAI_RUN_AFTER_WORKLOAD ?= 1
XSAI_DUMP_THP ?= 1
XSAI_TRACE_WORKLOAD ?= 1
XSAI_LLAMA_TEST_BACKEND_OPS ?= 1
XSAI_LLAMA_FAKE_BENCH_MODELS ?=
XSAI_LLAMA_FAKE_BENCH_P ?= 128
XSAI_LLAMA_FAKE_BENCH_N ?= 0
XSAI_LLAMA_FAKE_BENCH_R ?= 1
XSAI_LLAMA_FAKE_BENCH_WARMUP ?= 0
XSAI_LLAMA_FAKE_BENCH_ESTIMATE_LAYERS ?= 1
XSAI_LLAMA_FAKE_BENCH_FA ?= 0
XSAI_LLAMA_FAKE_BENCH_TYPE_K ?=
XSAI_LLAMA_FAKE_BENCH_TYPE_V ?=
XSAI_GGML_AME_LOG ?= 0
XSAI_GGML_AME_PACKED_Q8 ?= 1
XSAI_GGML_MEM_TRACE_NAME ?= *
XSAI_GGML_MEM_TRACE_OP ?= *
XSAI_GGML_MEM_TRACE_LAYER ?= 1
XSAI_CHECKPOINT_HERE_BEFORE ?=
XSAI_GOOD_TRAP_BEFORE ?=
XSAI_GGML_AME_FLASH_ATTN ?= 1
XSAI_GGML_AME_FLASH_ATTN_PROFILE ?= 0
XSAI_GGML_AME_FLASH_ATTN_VALIDATE ?= 0
XSAI_GGML_AME_WHOLE_K_Q8 ?= 0
XSAI_GGML_AME_WHOLE_K_FUSED_EPILOGUE ?= 0
XSAI_GGML_AME_F16_BF16 ?= 0
XSAI_GGML_AME_WHOLE_K_BF16 ?= 0
XSAI_GGML_AME_PROFILE ?= 1
XSAI_GGML_XSAI_OP_PROFILE ?= 1
XSAI_GGML_XSAI_OP_TIMING_LOG ?= 0
XSAI_AME_USE_PACKED_B_PANEL ?= 0

.PHONY: rootfsimg xsai-init-config $(APPS_DIR) clean

rootfsimg: xsai-init-config $(APPS_DIR)

xsai-init-config:
	@mkdir -p rootfsimg/build
	@{ \
	  echo "# Generated by firmware/riscv-rootfs/Makefile"; \
	  printf "XSAI_MODE='%s'\n" "$(XSAI_INIT_MODE)"; \
	  printf "WORKLOAD='%s'\n" "$(XSAI_WORKLOAD)"; \
	  printf "AUTO_EXIT='%s'\n" "$(XSAI_AUTO_EXIT)"; \
	  printf "DROP_SHELL='%s'\n" "$(XSAI_DROP_SHELL)"; \
	  printf "RUN_AFTER_WORKLOAD='%s'\n" "$(XSAI_RUN_AFTER_WORKLOAD)"; \
	  printf "DUMP_THP='%s'\n" "$(XSAI_DUMP_THP)"; \
	  printf "TRACE_WORKLOAD='%s'\n" "$(XSAI_TRACE_WORKLOAD)"; \
	  printf "XSAI_LLAMA_TEST_BACKEND_OPS='%s'\n" "$(XSAI_LLAMA_TEST_BACKEND_OPS)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_MODELS='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_MODELS)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_P='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_P)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_N='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_N)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_R='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_R)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_WARMUP='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_WARMUP)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_ESTIMATE_LAYERS='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_ESTIMATE_LAYERS)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_FA='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_FA)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_TYPE_K='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_TYPE_K)"; \
	  printf "XSAI_LLAMA_FAKE_BENCH_TYPE_V='%s'\n" "$(XSAI_LLAMA_FAKE_BENCH_TYPE_V)"; \
	  printf "GGML_AME_LOG='%s'\n" "$(XSAI_GGML_AME_LOG)"; \
	  printf "GGML_AME_PACKED_Q8='%s'\n" "$(XSAI_GGML_AME_PACKED_Q8)"; \
	  printf "GGML_MEM_TRACE_NAME='%s'\n" "$(XSAI_GGML_MEM_TRACE_NAME)"; \
	  printf "GGML_MEM_TRACE_OP='%s'\n" "$(XSAI_GGML_MEM_TRACE_OP)"; \
	  printf "GGML_MEM_TRACE_LAYER='%s'\n" "$(XSAI_GGML_MEM_TRACE_LAYER)"; \
	  printf "CHECKPOINT_HERE_BEFORE='%s'\n" "$(XSAI_CHECKPOINT_HERE_BEFORE)"; \
	  printf "GOOD_TRAP_BEFORE='%s'\n" "$(XSAI_GOOD_TRAP_BEFORE)"; \
	  printf "GGML_AME_FLASH_ATTN='%s'\n" "$(XSAI_GGML_AME_FLASH_ATTN)"; \
	  printf "GGML_AME_FLASH_ATTN_PROFILE='%s'\n" "$(XSAI_GGML_AME_FLASH_ATTN_PROFILE)"; \
	  printf "GGML_AME_FLASH_ATTN_VALIDATE='%s'\n" "$(XSAI_GGML_AME_FLASH_ATTN_VALIDATE)"; \
	  printf "GGML_AME_WHOLE_K_Q8='%s'\n" "$(XSAI_GGML_AME_WHOLE_K_Q8)"; \
	  printf "GGML_AME_WHOLE_K_FUSED_EPILOGUE='%s'\n" "$(XSAI_GGML_AME_WHOLE_K_FUSED_EPILOGUE)"; \
	  printf "GGML_AME_F16_BF16='%s'\n" "$(XSAI_GGML_AME_F16_BF16)"; \
	  printf "GGML_AME_WHOLE_K_BF16='%s'\n" "$(XSAI_GGML_AME_WHOLE_K_BF16)"; \
	  printf "GGML_AME_PROFILE='%s'\n" "$(XSAI_GGML_AME_PROFILE)"; \
	  printf "GGML_XSAI_OP_PROFILE='%s'\n" "$(XSAI_GGML_XSAI_OP_PROFILE)"; \
  printf "GGML_XSAI_OP_TIMING_LOG='%s'\n" "$(XSAI_GGML_XSAI_OP_TIMING_LOG)"; \
	  printf "XSAI_AME_USE_PACKED_B_PANEL='%s'\n" "$(XSAI_AME_USE_PACKED_B_PANEL)"; \
	} > rootfsimg/build/xsai-init.conf

$(APPS_DIR): %:
	@echo "$$(date '+[rootfs %F %T %z] START $@')"
	@$(MAKE) -s -C $@ install
	@echo "$$(date '+[rootfs %F %T %z] END $@')"

clean:
	-$(foreach app, $(APPS_DIR), $(MAKE) -s -C $(app) clean ;)
	-rm -f rootfsimg/build/*

distclean:
	-$(foreach app, $(APPS_DIR), $(MAKE) -s -C $(app) distclean ;)
	-rm -f rootfsimg/build/*
	-rm -rf apps/busybox/repo
	-rm -rf apps/llama.cpp/repo
