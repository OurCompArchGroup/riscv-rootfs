# Wrapper-only injection via CMAKE_PROJECT_INCLUDE. No managed-source writes.
# The existing fork lists xsai_alloc.c directly; replace it after target creation.
if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
    return()
endif()
if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "XSAI allocator integration requires CMake >= 3.19")
endif()
foreach(input XSAI_ALLOC_SRC XSAI_ALLOC_HEADER)
    if(NOT IS_ABSOLUTE "${${input}}" OR NOT EXISTS "${${input}}")
        message(FATAL_ERROR "${input} must name an existing absolute MNN allocator file")
    endif()
endforeach()

function(xsai_replace_allocator_in_directory directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        if(NOT target MATCHES "^ggml-cpu($|-)")
            continue()
        endif()
        get_target_property(sources "${target}" SOURCES)
        set(updated_sources "")
        set(replaced FALSE)
        foreach(source IN LISTS sources)
            if(source MATCHES "(^|/)xsai_alloc\\.c$")
                list(APPEND updated_sources "${XSAI_ALLOC_SRC}")
                set(replaced TRUE)
            else()
                list(APPEND updated_sources "${source}")
            endif()
        endforeach()
        if(replaced)
            set_property(TARGET "${target}" PROPERTY SOURCES "${updated_sources}")
            get_filename_component(allocator_include "${XSAI_ALLOC_HEADER}" DIRECTORY)
            target_include_directories("${target}" BEFORE PRIVATE "${allocator_include}")
            set_property(GLOBAL PROPERTY XSAI_ALLOCATOR_REPLACED TRUE)
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        xsai_replace_allocator_in_directory("${child}")
    endforeach()
endfunction()

function(xsai_use_mnn_allocator)
    xsai_replace_allocator_in_directory("${CMAKE_SOURCE_DIR}")
    get_property(replaced GLOBAL PROPERTY XSAI_ALLOCATOR_REPLACED)
    if(NOT replaced)
        message(FATAL_ERROR "No ggml-cpu xsai_alloc.c source found; check the locked llama.cpp source contract")
    endif()
    message(STATUS "XSAI shared allocator: ${XSAI_ALLOC_SRC}")
endfunction()

cmake_language(DEFER CALL xsai_use_mnn_allocator)
